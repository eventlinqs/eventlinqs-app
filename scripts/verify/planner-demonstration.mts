/**
 * DEMONSTRATION D (Lawal's final directive of 28 October 2026, section 27): a fresh week's campaign generated by the
 * actual weekly planner from TEST's verified nights, never assembled by hand. "Plan this week" is pressed through the
 * store (planCampaignWeek) as a TEST staff user; every piece's newest revision is then rendered by the real renderer at
 * each format it is made in, with its image as the register holds it now, the visual QA, its audience, objective, call
 * to action, link and picks, and a 390 px phone preview.
 *
 *   node --env-file=<a TEST env file> node_modules/tsx/dist/cli.mjs scripts/verify/planner-demonstration.mts <out dir>
 *
 * TEST only. It writes this week's campaign on TEST (one a week; a second run finds it) and leaves it there as the
 * demonstration; scripts/verify/social-campaign-drive-cleanup.sql removes campaign rows.
 */
import { mkdirSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'
import Module from 'node:module'
import { fileURLToPath } from 'node:url'
import { createClient } from '@supabase/supabase-js'
import sharp from 'sharp'
import type * as SlidesModule from '@/lib/broadcast/campaign-slides'
import type * as StoreModule from '@/lib/social/store'

const EMPTY = fileURLToPath(new URL('../../tests/stubs/empty.ts', import.meta.url))
const cjs = Module as unknown as { _resolveFilename: (request: string, ...rest: unknown[]) => string }
const resolveFilename = cjs._resolveFilename
cjs._resolveFilename = (request: string, ...rest: unknown[]) =>
  request === 'server-only' || request === 'client-only' ? EMPTY : resolveFilename(request, ...rest)

const pick = <T,>(mod: T & { default?: T }) => (mod.default ?? mod) as T
const slides = pick((await import('@/lib/broadcast/campaign-slides')) as typeof SlidesModule & { default?: typeof SlidesModule })
const store = pick((await import('@/lib/social/store')) as typeof StoreModule & { default?: typeof StoreModule })

/*
 * --now <ISO time>: plan the week holding that moment instead of today's (the project manager's 21:48 of 29 October
 * 2026, (7): AMCF's campaign ready in TEST's planner for its own week, 20 to 22 November). The week is planned exactly
 * as "Plan this week" would plan it on that day; nothing is posted.
 */
const nowAt = process.argv.indexOf('--now')
const nowArg = nowAt > -1 ? process.argv.splice(nowAt, 2)[1] : null
if (nowAt > -1 && (!nowArg || Number.isNaN(Date.parse(nowArg)))) throw new Error('--now takes an ISO time, e.g. 2026-11-16T01:00:00Z')
const out = process.argv[2] ?? 'planner-demonstration'
mkdirSync(out, { recursive: true })
const url = process.env.NEXT_PUBLIC_SUPABASE_URL ?? ''
if (!url.includes('vkapkibzokmfaxqogypq')) throw new Error('TEST only: pass a TEST env file')
const db = createClient(url, process.env.SUPABASE_SERVICE_ROLE_KEY ?? '', { auth: { persistSession: false } })
const { data: admin } = await db.from('admin_users').select('id').limit(1).maybeSingle()
const by = admin?.id as string
const now = nowArg ? new Date(nowArg) : new Date()

const planned = await store.planCampaignWeek(db, { plannedBy: by, now })
console.log(`PLANNED ${planned.weekStart}: ${planned.created} piece(s) new, ${planned.existing} found, ${planned.requests} image request(s), held: ${planned.held.length ? planned.held.join('; ') : 'none'}`)
const campaign = await store.readCampaign(db, now)
if (!campaign) throw new Error('the campaign could not be read back')

const report: unknown[] = []
let faults = 0
for (const p of campaign.pieces) {
  const rev = p.revision
  const images = await store.slideImagesNow(db, rev.slides, now)
  const qa = await slides.visualFaults(rev.slides, p.format, images)
  faults += qa.length
  const files: string[] = []
  for (const f of slides.formatsOf(p.format)) {
    for (const [i, s] of rev.slides.entries()) {
      const bytes = await slides.renderCampaignSlide(f, s, i + 1, rev.slides.length, null, images.get(i) ?? null)
      const name = `${p.kind}-${p.city}${p.partnerName ? `-${p.partnerName.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` : ''}-${String(i + 1).padStart(2, '0')}-${f === 'feed' ? 'portrait' : f}`
      writeFileSync(join(out, `${name}.jpg`), bytes)
      if (i === 0) await sharp(Buffer.from(bytes)).resize({ width: 390 }).png().toFile(join(out, `${name}-phone-390.png`))
      files.push(`${name}.jpg`)
    }
  }
  report.push({
    piece: p.kind,
    city: p.city,
    partner: p.partnerName,
    audience: p.audience,
    objective: p.objective,
    purpose: p.purpose,
    callToAction: p.nextStep,
    link: p.link,
    treatment: rev.mode,
    picks: rev.picks,
    slides: rev.slides.map((s) => s.t),
    images: [...images.entries()].map(([i, u]) => ({ slide: i + 1, image: u?.url ?? 'gone: drawn in type' })),
    qa: qa.length === 0 ? 'PASS' : qa,
    files,
    state: p.state,
  })
}
writeFileSync(join(out, 'report.json'), JSON.stringify({ planned, weekStart: campaign.weekStart, pieces: report }, null, 2))
console.log(`RENDERED ${campaign.pieces.length} piece(s) into ${out}; visual QA ${faults === 0 ? 'PASS on every slide at every format' : `${faults} fault(s), each in report.json`}`)
for (const r of report as { piece: string; city: string; partner: string | null; treatment: string; qa: unknown; slides: string[] }[]) {
  console.log(`  ${r.piece} ${r.city}${r.partner ? ` (${r.partner})` : ''}: ${r.slides.length} slide(s), ${r.treatment}, QA ${r.qa === 'PASS' ? 'PASS' : JSON.stringify(r.qa)}`)
}
