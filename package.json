{
  "name": "eventlinqs-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-disk-space.mjs && node scripts/check-public-env.mjs && node scripts/check-pricing-lock.mjs && node scripts/guards/run-guards.mjs && node scripts/prebuild-fixture.mjs",
    "build": "next build",
    "start": "next start",
    "reclaim": "node scripts/reclaim-space.mjs",
    "lint": "eslint",
    "pretest": "node scripts/seed-events-catalogue.mjs --fixture",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:proof:setup": "playwright test --config playwright.admin.config.ts --project setup --headed",
    "admin:proof": "playwright test --config playwright.admin.config.ts --project desktop && playwright test --config playwright.admin.config.ts --project mobile",
    "admin:lighthouse": "node scripts/admin-lighthouse.mjs",
    "guards": "node scripts/guards/run-guards.mjs",
    "guards:contract-node": "node scripts/guards/contract-node.mjs",
    "guards:surface": "node scripts/guards/contract-node.mjs scripts/guards/lib/generate-node-surface.mjs",
    "guards:drills": "node scripts/verify/guard-failure-drills.mjs",
    "verify:provider-cost": "node scripts/verify/auth-provider-cache-cost.mjs",
    "gates": "node scripts/guards/run-guards.mjs && node scripts/guards/preview-deployment-state.mjs && tsc --noEmit && eslint && vitest run && npm run build",
    "gates:preview-state": "node scripts/guards/preview-deployment-state.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-email/components": "^1.0.11",
    "@sentry/nextjs": "^10.69.0",
    "@stripe/react-stripe-js": "^6.1.0",
    "@stripe/stripe-js": "^9.0.1",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "@tanstack/react-query": "^5.96.1",
    "@types/mapbox-gl": "^3.4.1",
    "@upstash/redis": "^1.37.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.7.0",
    "mapbox-gl": "^3.23.1",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1",
    "stripe": "^21.0.1",
    "tailwind-merge": "^3.5.0",
    "web-push": "^3.6.7",
    "zustand": "^5.0.12"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "not dead"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.37",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.1.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
